{
  "name": "sdlc-workflow-pi",
  "version": "10.0.0-next.5",
  "private": true,
  "description": "The pi package of the sdlc-workflow plugin: the bundled pi packages that run its skills, hooks and workflow driver on pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-coding-agent",
    "extension"
  ],
  "license": "MIT",
  "scripts": {
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@juicesharp/rpiv-ask-user-question": "2.10.1",
    "@tintinweb/pi-subagents": "0.19.0",
    "pi-code": "1.0.64",
    "pi-web-access": "0.30.0"
  },
  "bundledDependencies": [
    "@juicesharp/rpiv-ask-user-question",
    "@tintinweb/pi-subagents",
    "pi-code",
    "pi-web-access"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.2"
  },
  "pi": {
    "extensions": [
      "./extensions",
      "./node_modules/pi-web-access/dist",
      "./node_modules/pi-code/extensions",
      "-node_modules/pi-code/extensions/web.ts",
      "-node_modules/pi-code/extensions/subagent/index.ts",
      "-node_modules/pi-code/extensions/question.ts",
      "./node_modules/@tintinweb/pi-subagents/src/index.ts",
      "./node_modules/@juicesharp/rpiv-ask-user-question/index.ts"
    ]
  }
}
