{{!--
  explainer/layout — spatial relationships: a labelled grid of regions (a
  screen, a pitch, a page). Pure HTML + CSS grid, no script; colours are the
  view's theme tokens, so the visual follows the page theme.

  <!-- @include explainer/layout {"title": "Match screen", "cols": 4, "rows": 3,
       "regions": [
         {"label": "Score bar", "col": 1, "row": 1, "w": 4},
         {"label": "Pitch", "col": 1, "row": 2, "w": 3, "h": 2, "tone": "ok", "note": "live positions"},
         {"label": "Events", "col": 4, "row": 2, "h": 2, "tone": "muted"}
       ],
       "caption": "The pitch keeps three quarters of the width."} -->

  Parameters: title (optional), cols and rows (optional; default the extent
  the regions need), regions[].label, regions[].col and regions[].row (1-based),
  regions[].w and regions[].h (optional spans, default 1), regions[].tone
  (optional: accent | ok | warn | bad | risk | muted), regions[].note
  (optional), caption (optional; a line under the grid).
--}}
<figure class="xpl xpl-layout" style="margin:18px 0;padding:14px 16px;border:1px solid var(--rule);border-radius:var(--rad-md);background:var(--paper)">
{{#each title_list}}<figcaption style="font-family:var(--sans);font-size:13px;font-weight:600;color:var(--ink-2);margin:0 0 10px">{{this}}</figcaption>{{/each}}
<div role="group" aria-label="{{aria}}" style="display:grid;grid-template-columns:repeat({{cols}},minmax(0,1fr));grid-template-rows:repeat({{rows}},minmax(52px,auto));gap:6px;padding:6px;border:1px dashed var(--rule-2);border-radius:var(--rad-md);background:var(--paper-2)">
{{#each regions}}<div style="grid-area:{{this.area}};min-width:0;padding:6px 8px;border:1.5px solid {{this.stroke}};border-radius:var(--rad-sm);background:{{this.bg}};overflow-wrap:break-word;hyphens:auto"><div style="font-family:var(--sans);font-size:clamp(11.5px,3.2vw,13px);font-weight:600;line-height:1.3;color:var(--ink)">{{this.label}}</div>{{#each this.note_list}}<div style="font-family:var(--sans);font-size:clamp(11px,3vw,12px);line-height:1.4;color:var(--ink-2);margin-top:3px">{{this}}</div>{{/each}}</div>
{{/each}}</div>
{{#each caption_list}}<div style="font-size:13.5px;color:var(--ink-2);margin:8px 0 0">{{this}}</div>{{/each}}
</figure>
