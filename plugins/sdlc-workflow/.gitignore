# The plugin runs from its source and has no runtime dependencies, so a fresh
# marketplace install needs no `npm install`. There is no build output: an old
# local dist/ is ignored, and nothing reads it.
node_modules/
dist/

# The tray app (TRAY-APP-PLAN.md) ships fully self-contained: the systray2 Go
# helper binaries and the rasterized sunflower icons are COMMITTED so the tray
# runs on a fresh clone with zero `npm install`. Explicit allow-rules keep them
# tracked despite any broad ancestor ignore.
!bin/
!bin/**
!assets/app-icon*

# hooks/_adapter.mjs falls back to <pluginRoot>/.plugin-data when Codex does not
# substitute --plugin-data (manual or test runs in the dev tree). Never commit it.
.plugin-data/


# The Claude Code mod under hooks/mod/ typechecks against the declarations that
# `/plugin-types` writes to .claude/types/. They are a build input, not a source.
.claude/types/
