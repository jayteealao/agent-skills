# Enforce LF for all text files in this plugin so the committed dist/ bundles
# and the tests that read files byte for byte behave the same on Windows and
# Linux; a Windows clone with core.autocrlf=true would otherwise get CRLF in
# the working tree.
* text=auto eol=lf
*.md text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.sh text eol=lf
*.css text eol=lf
*.html text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
