{
  "name": "task",
  "order": 110,
  "fixture": "docs-repo",
  "prompt": "/wf task rename the docs folder to guide and fix every link that points into it",
  "maxTurns": 60,
  "assertions": [
    {
      "type": "exists",
      "glob": ".ai/workflows/*/01-task.md",
      "min": 1,
      "max": 1
    },
    {
      "type": "frontmatter-valid",
      "glob": ".ai/workflows/*/01-task.md"
    },
    {
      "type": "frontmatter-has",
      "glob": ".ai/workflows/*/01-task.md",
      "field": "blast-radius"
    },
    {
      "type": "file-contains",
      "path": ".ai/workflows/<slug>/01-task.md",
      "pattern": "(?i)attested|asserted"
    }
  ]
}
